
# For local development with Firebase Emulator Suite
# Replace YOUR_PROJECT_ID with your actual Firebase project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_URL=http://127.0.0.1:5001

# If deploying, ensure these are set as environment variables in your hosting environment
# NEXT_PUBLIC_FIREBASE_PROJECT_ID should be your actual Firebase project ID.
# NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_URL would typically not be set for deployed environments,
# as the API route will default to the live function URL.
